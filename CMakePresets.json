{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "gcc",
      "inherits": "base",
      "description": "Build using GCC",
      "toolchainFile": "${sourceDir}/toolchains/gcc-arm.cmake"
    },
    {
      "name": "default",
      "inherits": "gcc"
    }
  ]
}
